# Sao chép file này thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.
# Để trống GEMINI_API_KEY thì app chạy chế độ demo (Bé Bảng trả lời mẫu, tách ghi chú bằng quy tắc).

# Khóa Gemini lấy ở https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tùy chọn: đổi model mà không cần sửa code (xem src/lib/ai/models.ts)
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# GEMINI_MODEL_DEFAULT=gemini-3.8-flash
# GEMINI_MODEL_HEAVY=gemini-3.8-flash

# Supabase (chưa dùng ở giai đoạn 1 — dữ liệu đang lưu trên trình duyệt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mật khẩu chung khi đưa bản chạy thử lên mạng (để trống = không hỏi mật khẩu)
SITE_PASSWORD=
